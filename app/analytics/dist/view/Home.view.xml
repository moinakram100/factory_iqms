<mvc:View controllerName="com.ingenx.qms.analytics.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
     xmlns:tnt="sap.tnt"
    xmlns="sap.m">
    

       <Page
        id="analyticsPage"
        showHeader="false"
