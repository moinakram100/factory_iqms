  "scripts": {
    "start": "cds-serve",
    "watch-factoryapp": "cds watch --open factoryapp/webapp/index.html?sap-ui-xx-viewCache=false",
    "watch-scheduling": "cds watch --open scheduling/webapp/index.html?sap-ui-xx-viewCache=false",
    "watch-truckassignment": "cds watch --open truckassignment/webapp/index.html?sap-ui-xx-viewCache=false",
    "watch-createparking": "cds watch --open createparking/webapp/index.html?sap-ui-xx-viewCache=false",
    "watch-config": "cds watch --open config/webapp/index.html?sap-ui-xx-viewCache=false",
    "watch-inventory": "cds watch --open inventory/webapp/index.html?sap-ui-xx-viewCache=false",
    "watch-billingcreation": "cds watch --open billingcreation/webapp/index.html?sap-ui-xx-viewCache=false",
    "watch-fangeneration": "cds watch --open fangeneration/webapp/index.html?sap-ui-xx-viewCache=false",
    "watch-parking": "cds watch --open parking/webapp/index.html?sap-ui-xx-viewCache=false",
    "watch-analytics": "cds watch --open analytics/webapp/index.html?sap-ui-xx-viewCache=false",
    "undeploy": "cf undeploy factory_IQMS --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "watch-analyticsfactory": "cds watch --open analyticsfactory/webapp/index.html?sap-ui-xx-viewCache=false",
    "watch-parkingfactory": "cds watch --open parkingfactory/webapp/index.html?sap-ui-xx-viewCache=false",
    "watch-schedulingfactory": "cds watch --open schedulingfactory/webapp/index.html?sap-ui-xx-viewCache=false",
    "watch-truckassignmentfactory": "cds watch --open truckassignmentfactory/webapp/index.html?sap-ui-xx-viewCache=false",
    "watch-configfactory": "cds watch --open configfactory/webapp/index.html?sap-ui-xx-viewCache=false",
    "watch-pgi_gr_billing": "cds watch --open pgi_gr_billing/webapp/index.html?sap-ui-xx-viewCache=false",
    "watch-fangenerationfactory": "cds watch --open fangenerationfactory/webapp/index.html?sap-ui-xx-viewCache=false"
  },
